{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "博邦 ERP 桌面端默认权限",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {"url": "http://127.0.0.1:*/*"},
        {"url": "http://localhost:*/*"},
        {"url": "http://10.*.*.*:*/*"},
        {"url": "http://172.*.*.*:*/*"},
        {"url": "http://192.168.*.*:*/*"},
        {"url": "https://*/*"}
      ]
    }
  ]
}
