{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "博邦 ERP",
  "version": "0.1.0",
  "identifier": "com.bobang.erp.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "博邦 ERP 管理系统",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "博邦 ERP 桌面客户端",
    "longDescription": "博邦 ERP 管理系统桌面客户端，复用 Web 管理端并连接 Go 后端 API。"
  }
}
