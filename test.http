### 上传产品图片
POST http://127.0.0.1:8080/api/v1/files/images
Content-Type: multipart/form-data; boundary=image-boundary
Authorization: Bearer {{token}}

--image-boundary
Content-Disposition: form-data; name="owner_type"

product
--image-boundary
Content-Disposition: form-data; name="owner_id"

{{product_id}}
--image-boundary
Content-Disposition: form-data; name="category"

main
--image-boundary
Content-Disposition: form-data; name="file"; filename="bobang-logo-hd.png"
Content-Type: image/png

< ./web/public/bobang-logo-hd.png
--image-boundary--

> {% client.global.set("image_id", response.body[0].id); %}

