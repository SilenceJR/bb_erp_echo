Authorization: Bearer {{token}}

--image-batch-boundary
Content-Disposition: form-data; name="owner_type"

product
--image-batch-boundary
Content-Disposition: form-data; name="owner_id"

{{product_id}}
--image-batch-boundary
Content-Disposition: form-data; name="category"

detail
--image-batch-boundary
Content-Disposition: form-data; name="file"; filename="bobang-logo-hd.png"
Content-Type: image/png

< ./web/public/bobang-logo-hd.png
--image-batch-boundary
Content-Disposition: form-data; name="file"; filename="bobang-logo-hd-copy.png"
Content-Type: image/png

< ./web/public/bobang-logo-hd.png
--image-batch-boundary--

